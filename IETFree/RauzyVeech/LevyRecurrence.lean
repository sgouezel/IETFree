module

public import Mathlib

/-!
# Lévy's upward theorem applied to a cylinder filtration: the abstract recurrence lemma

This file proves `LevyRecurrence.levy_recurrence`: if a probability measure `μ` on `X` carries
a sequence of finite level maps `π n : X → Y n` refining each other, and if every atom of every
level `n ≥ N` contains a subset (not assumed measurable) of relative outer measure at least `δ`
which avoids a target set `Z` measurable for the σ-algebra generated by the levels, then `μ Z = 0`.

It is the device that converts "a definite fraction of every cylinder falls into descendants
avoiding `Z`, at unbounded depth" into "`Z` is null", and hence the reason the reset depth may be
unbounded.  It is used for richness of the greedy path (`RichPath.richGreedyPath`,
`IETFree/RauzyVeech/RichPath/RichPathAssembly.lean`).

Note the level σ-algebra: `F n = MeasurableSpace.comap (π n) ⊤` with the **discrete** σ-algebra on
`Y n`, so that its measurable sets are the unions of atoms.  (`⊥` would be wrong: on
`MeasurableSpace` the bottom element is the *indiscrete* σ-algebra, `measurableSet_bot_iff`, which
would make every level trivial.  The literal bottom version is degenerate and is not used.) -/

@[expose] public section


open MeasureTheory Filter
open scoped ENNReal Topology

-- `Finite (Y n)` is used in the proof (the union of the null atoms is countable), not in the
-- statement; the levels are finite partitions by hypothesis of the application.

namespace LevyRecurrence

variable {X : Type*} [MeasurableSpace X] {μ : Measure X} [IsProbabilityMeasure μ]

/-- **The recurrence lemma.**  Let `μ` be a probability measure on `X` and `π n : X → Y n` a
sequence of measurable level maps with `Finite (Y n)`, refining each other.  Let `Z` be measurable
for the σ-algebra generated by all the levels.  If there are `N : ℕ` and `δ > 0` such that every
atom `{x | π n x = y}` of every level `n ≥ N` contains a subset `Fy` (not assumed measurable; `μ Fy`
is the outer measure) with `μ Fy ≥ δ * μ (atom)` and `Fy ∩ Z = ∅`, then `μ Z = 0`.  The σ-algebra of
level `n` is `F n = MeasurableSpace.comap (π n) ⊤` (the discrete σ-algebra on the finite type `Y
n`), so that its measurable sets are exactly the unions of atoms. -/
theorem levy_recurrence {Y : ℕ → Type*} [∀ n, MeasurableSpace (Y n)]
    [∀ n, MeasurableSingletonClass (Y n)] [∀ n, Finite (Y n)]
    (π : ∀ n, X → Y n) (hπ : ∀ n, Measurable (π n))
    (hrefine : ∀ (n : ℕ) (x y : X), π (n + 1) x = π (n + 1) y → π n x = π n y)
    {Z : Set X} (hZ : MeasurableSet[⨆ n, MeasurableSpace.comap (π n) ⊤] Z)
    (N : ℕ) {δ : ℝ} (hδ : 0 < δ)
    (h : ∀ (n : ℕ), N ≤ n → ∀ y : Y n, ∃ Fy : Set X, Fy ⊆ {x | π n x = y} ∧
      ENNReal.ofReal δ * μ {x | π n x = y} ≤ μ Fy ∧ Disjoint Fy Z) :
    μ Z = 0 := by
  suffices h : ¬ 0 < μ Z by simpa only [not_lt, nonpos_iff_eq_zero] using h
  intro hZpos
  -- ## Step 0: the level σ-algebras and measurability of atoms
  set F : ℕ → MeasurableSpace X := fun n => MeasurableSpace.comap (π n) ⊤ with hFdef
  -- with finitely many atoms, every subset of `Y n` is measurable
  have hAllMeas (n : ℕ) (s : Set (Y n)) : MeasurableSet s := by
    rw [← Set.biUnion_of_singleton s]
    exact MeasurableSet.biUnion (Set.toFinite s).countable fun y _ => measurableSet_singleton y
  have hAtom (n : ℕ) (y : Y n) : MeasurableSet {x | π n x = y} :=
    hπ n (measurableSet_singleton y)
  have hAtomF (n : ℕ) (y : Y n) : MeasurableSet[F n] {x | π n x = y} := by
    exact (MeasurableSpace.measurableSet_comap (m := ⊤)).mpr ⟨{y}, trivial, rfl⟩
  -- ## Step 1: `F` is a filtration
  have hFle (n) : F n ≤ ‹MeasurableSpace X› := by
    intro s hs
    rw [hFdef] at hs
    obtain ⟨s', -, rfl⟩ := MeasurableSpace.measurableSet_comap.mp hs
    exact hπ n (hAllMeas n s')
  have hstep (n) : F n ≤ F (n + 1) := by
    intro s hs
    rw [hFdef] at hs ⊢
    obtain ⟨s', -, rfl⟩ := MeasurableSpace.measurableSet_comap.mp hs
    have hEq : (π n) ⁻¹' s' = ⋃ y ∈ s', {x | π n x = y} := by
      ext x
      simp only [Set.mem_preimage, Set.mem_iUnion, exists_prop, Set.mem_ofPred_eq]
      exact ⟨fun hx => ⟨π n x, hx, rfl⟩, by rintro ⟨y, hy, hxy⟩; rw [hxy]; exact hy⟩
    rw [hEq]
    refine MeasurableSet.biUnion (Set.toFinite s').countable fun y _ => ?_
    refine MeasurableSpace.measurableSet_comap.mpr
      ⟨{z : Y (n + 1) | ∀ x, π (n + 1) x = z → π n x = y}, trivial, ?_⟩
    ext x
    simp only [Set.mem_preimage, Set.mem_ofPred_eq]
    exact ⟨fun hx => hx x rfl, fun hx x' hx' => by rw [hrefine n x' x hx', hx]⟩
  have hFmono : Monotone F := monotone_nat_of_le_succ hstep
  let ℱ : Filtration ℕ ‹MeasurableSpace X› := ⟨F, hFmono, hFle⟩
  have hZamb : MeasurableSet Z := (iSup_le hFle) Z hZ
  -- ## Step 2: Lévy's upward theorem for `g = 1_Z`
  set g : X → ℝ := Z.indicator (fun _ => 1) with hgdef
  have hg_int : Integrable g μ := (integrable_const (1 : ℝ)).indicator hZamb
  have hg_sm : StronglyMeasurable[⨆ n, ℱ n] g :=
    (stronglyMeasurable_const (b := (1 : ℝ))).indicator hZ
  have htendsto : ∀ᵐ x ∂μ, Tendsto (fun n => (μ[g | ℱ n]) x) atTop (𝓝 (g x)) :=
    hg_int.tendsto_ae_condExp hg_sm
  -- ## Step 3: the levels `U n` where the conditional expectation is close to `1`
  set U : ℕ → Set X := fun n => {x | 1 - δ / 2 < (μ[g | ℱ n]) x} with hUdef
  have hUmeas (n) : MeasurableSet[F n] (U n) := by
    have h1 : StronglyMeasurable[F n] fun x => (μ[g | ℱ n]) x := stronglyMeasurable_condExp
    have h2 : StronglyMeasurable[F n] fun _ : X => (1 - δ / 2 : ℝ) := stronglyMeasurable_const
    exact h2.measurableSet_lt h1
  have hUamb (n) : MeasurableSet (U n) := hFle n (U n) (hUmeas n)
  have hconv : ∀ᵐ x ∂μ, x ∈ Z → ∀ᶠ n in atTop, x ∈ U n := by
    filter_upwards [htendsto] with x hx hxZ
    have hgx : g x = 1 := by simp only [hgdef, Set.indicator_of_mem hxZ]
    rw [hgx] at hx
    exact hx.eventually (Ioi_mem_nhds (by linarith : (1 - δ / 2 : ℝ) < 1))
  set W : Set X := {x | ∀ᶠ n in atTop, x ∈ U n} with hWdef
  have hZW : μ (Z \ W) = 0 := by
    have h := ae_iff.mp hconv
    refine measure_mono_null ?_ h
    intro x hx
    exact fun hZ => hx.2 (hZ hx.1)
  have hposT : 0 < μ (Z ∩ W) := by
    refine lt_of_lt_of_le hZpos ?_
    have hsub : Z ⊆ (Z ∩ W) ∪ (Z \ W) := by
      intro x hx
      by_cases h : x ∈ W
      · exact Or.inl ⟨hx, h⟩
      · exact Or.inr ⟨hx, h⟩
    calc μ Z ≤ μ ((Z ∩ W) ∪ (Z \ W)) := measure_mono hsub
      _ ≤ μ (Z ∩ W) + μ (Z \ W) := measure_union_le _ _
      _ = μ (Z ∩ W) := by rw [hZW, add_zero]
  -- ## Step 4: forget the points whose level-`n` atom is null
  set bad : ℕ → Set X :=
    fun n => ⋃ y : Y n, if μ {x | π n x = y} = 0 then {x | π n x = y} else ∅ with hbaddef
  have hbadnull (n) : μ (bad n) = 0 := by
    rw [hbaddef]
    refine measure_iUnion_null fun y => ?_
    by_cases hy : μ {x | π n x = y} = 0
    · simp only [hy, if_true]
    · simp only [hy, if_false]; exact measure_empty
  have hbadUnion : μ (⋃ n, bad n) = 0 := measure_iUnion_null hbadnull
  have hpos : 0 < μ ((Z ∩ W) \ ⋃ n, bad n) := by
    refine lt_of_lt_of_le hposT ?_
    have hsub : Z ∩ W ⊆ ((Z ∩ W) \ ⋃ n, bad n) ∪ ⋃ n, bad n := by
      intro x hx
      by_cases h : x ∈ ⋃ n, bad n
      · exact Or.inr h
      · exact Or.inl ⟨hx, h⟩
    calc μ (Z ∩ W) ≤ μ (((Z ∩ W) \ ⋃ n, bad n) ∪ ⋃ n, bad n) := measure_mono hsub
      _ ≤ μ ((Z ∩ W) \ ⋃ n, bad n) + μ (⋃ n, bad n) := measure_union_le _ _
      _ = μ ((Z ∩ W) \ ⋃ n, bad n) := by rw [hbadUnion, add_zero]
  -- pick a good point
  have hne : ((Z ∩ W) \ ⋃ n, bad n).Nonempty := by
    rw [Set.nonempty_iff_ne_empty]
    rintro h
    rw [h] at hpos
    simp only [measure_empty] at hpos
    exact lt_irrefl 0 hpos
  obtain ⟨x, hxmem⟩ := hne
  have hxZ : x ∈ Z := hxmem.1.1
  have hxW : x ∈ W := hxmem.1.2
  obtain ⟨n₁, hn₁⟩ := Filter.eventually_atTop.mp hxW
  -- level `n ≥ N` at which the bound holds at `x`
  set n : ℕ := max n₁ N with hndef
  have hnN : N ≤ n := le_max_right _ _
  have hn1 : n₁ ≤ n := le_max_left _ _
  have hxU : x ∈ U n := hn₁ n hn1
  -- the atom of `x` at level `n`, which is non-null
  set A : Set X := {y | π n y = π n x} with hAdef
  have hAmeas : MeasurableSet A := hAtom n (π n x)
  have hAF : MeasurableSet[F n] A := hAtomF n (π n x)
  have hxA : x ∈ A := rfl
  have hAne : μ A ≠ 0 := by
    intro h0
    refine hxmem.2 (Set.mem_iUnion.mpr ⟨n, ?_⟩)
    rw [hbaddef]
    refine Set.mem_iUnion.mpr ⟨π n x, ?_⟩
    have h0' : μ {y : X | π n y = π n x} = 0 := by simpa only [hAdef] using h0
    simp only [h0', if_true]
    exact hxA
  -- ## Step 5: the bound holds on the whole atom (the conditional expectation is atom-constant)
  have hAsubU : A ⊆ U n := by
    have hu := hUmeas n
    rw [hFdef] at hu
    obtain ⟨s, -, hs⟩ := MeasurableSpace.measurableSet_comap.mp hu
    intro y hy
    have h2 : π n x ∈ s := by
      have hx : x ∈ (π n) ⁻¹' s := by rw [hs]; exact hxU
      exact hx
    have h3 : y ∈ (π n) ⁻¹' s := by
      have h4 : π n y ∈ s := by rw [hy]; exact h2
      exact h4
    rw [hs] at h3
    exact h3
  -- ## Step 6: the two integral bounds
  have hint : ∫ y in A, (μ[g | ℱ n]) y ∂μ = μ.real (A ∩ Z) := by
    rw [setIntegral_condExp (ℱ.le n) hg_int hAF, hgdef, setIntegral_indicator hZamb]
    simp
  have hlower : (1 - δ / 2) * μ.real A ≤ μ.real (A ∩ Z) := by
    rw [← hint]
    have hle : ∫ y in A, (1 - δ / 2 : ℝ) ∂μ ≤ ∫ y in A, (μ[g | ℱ n]) y ∂μ := by
      refine setIntegral_mono_on ?_ ?_ hAmeas ?_
      · exact integrableOn_const
      · exact integrable_condExp.integrableOn
      · intro y hy
        exact le_of_lt (hAsubU hy)
    calc (1 - δ / 2) * μ.real A = ∫ y in A, (1 - δ / 2 : ℝ) ∂μ := by
          rw [setIntegral_const, smul_eq_mul, mul_comm]
      _ ≤ _ := hle
  -- the recurrence hypothesis at the atom
  obtain ⟨Fy, hFysub, hFybd, hFydisj⟩ := h n hnN (π n x)
  have hFysub' : Fy ⊆ A \ Z := fun y hy => ⟨hFysub hy, hFydisj.le_compl_right hy⟩
  have hStep1 : μ.real Fy ≤ μ.real (A \ Z) := measureReal_mono hFysub'
  have hAfin : μ A ≠ ⊤ := by
    have hle : μ A ≤ 1 := by
      have h1 : μ A ≤ μ Set.univ := measure_mono (Set.subset_univ A)
      simpa using h1
    exact ne_top_of_le_ne_top (by simp) hle
  have hFyfin : μ Fy ≠ ⊤ := ne_top_of_le_ne_top hAfin (measure_mono hFysub)
  have hStep2 : δ * μ.real A ≤ μ.real Fy := by
    rw [Measure.real_def, Measure.real_def]
    calc δ * (μ A).toReal = (ENNReal.ofReal δ * μ A).toReal := by
          rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal hδ.le]
      _ ≤ (μ Fy).toReal := ENNReal.toReal_mono hFyfin hFybd
  have hStep3 : μ.real (A ∩ Z) + μ.real (A \ Z) = μ.real A :=
    measureReal_inter_add_sdiff hZamb
  have hupper : μ.real (A ∩ Z) ≤ (1 - δ) * μ.real A := by linarith
  -- ## Step 7: contradiction
  have hApos : 0 < μ.real A := by
    rw [Measure.real_def]
    exact ENNReal.toReal_pos hAne hAfin
  nlinarith [mul_pos hδ hApos]

end LevyRecurrence

end
